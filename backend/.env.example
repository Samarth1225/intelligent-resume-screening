# Copy this file to .env and adjust as needed. All values shown are the
# built-in defaults (app/config.py) — the app runs fine with none of these
# set.

# SQLite by default; point elsewhere (e.g. Postgres) if you outgrow the MVP.
DATABASE_URL=sqlite:///./resume_screening.db

# Where uploaded resumes are stored on disk.
UPLOAD_DIR=./uploads

# Comma-separated list of allowed CORS origins for the frontend. "*" is fine
# for local development.
CORS_ORIGINS=*

# Demo login (MVP only — replace with real auth before any real deployment).
DEMO_USER_EMAIL=demo@resumescreen.ai
DEMO_USER_PASSWORD=demo1234
DEMO_TOKEN=demo-static-token-irscs
